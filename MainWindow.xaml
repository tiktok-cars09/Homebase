<Window x:Class="Homebase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Homebase" Width="1240" Height="860" MinWidth="960" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="28"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#151619" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource AccentBrush}">
            <TextBlock Text="H" Foreground="#171A11" FontSize="17" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="homebase" Margin="10,0,0,0" FontSize="17" FontWeight="Bold"
                     VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="  /  your PC, in one place" Margin="13,0,0,0" Foreground="{StaticResource MutedBrush}"
                     FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TodayDate" Foreground="{StaticResource MutedBrush}" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,15,0"/>
          <Button x:Name="FocusButton" Content="Focus mode" Margin="0,0,8,0"/>
          <Button x:Name="QuickAddButton" Content="+   Quick add" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Grid.Row="1" Background="{StaticResource BackgroundBrush}"
                BorderThickness="0" SelectedIndex="0">
      <TabControl.Resources>
        <Style TargetType="TabItem">
          <Setter Property="Foreground" Value="#A7A8AD"/>
          <Setter Property="Background" Value="#151619"/>
          <Setter Property="Padding" Value="19,11"/>
          <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                        Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter TargetName="TabSurface" Property="Background" Value="#1B1C20"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem Header="⌂   Home">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel MaxWidth="1100" HorizontalAlignment="Center" Margin="26,26,26,36">
            <StackPanel Margin="4,0,0,22">
              <TextBlock x:Name="Greeting" Text="Good to see you." FontSize="33" FontWeight="SemiBold"/>
              <TextBlock Text="A little space for everything you get up to." Foreground="{StaticResource MutedBrush}"
                         FontSize="13" Margin="0,7,0,0"/>
            </StackPanel>
            <Border CornerRadius="13" BorderBrush="#34362D" BorderThickness="1" Padding="28,25"
                    Background="#1B1D1A" MinHeight="175">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="175"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="YOUR HOME BASE" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                  <TextBlock Text="What are you feeling like?" FontSize="26" FontWeight="SemiBold" Margin="0,10,0,5"/>
                  <TextBlock Text="Pick up a project, get some work done, or jump into a show."
                             Foreground="#A7A8A2" FontSize="12"/>
                  <Button x:Name="ExploreButton" Content="Add something to your list" Style="{StaticResource PrimaryButton}"
                          HorizontalAlignment="Left" Margin="0,17,0,0"/>
                </StackPanel>
                <Grid Grid.Column="1" Width="150" Height="125" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Ellipse Width="142" Height="65" Stroke="#555D45" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform><RotateTransform Angle="-25"/></Ellipse.RenderTransform>
                  </Ellipse>
                  <Border Width="70" Height="70" CornerRadius="35" Background="#B5D96E" BorderBrush="#D7F694" BorderThickness="1">
                    <TextBlock Text="*" FontSize="28" Foreground="#202517" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
              </Grid>
            </Border>

            <Grid Margin="4,26,4,11">
              <TextBlock Text="Today, your way" FontSize="15" FontWeight="SemiBold"/>
              <Button x:Name="ClearCompletedButton" Content="Clear completed" HorizontalAlignment="Right"
                      Padding="7,3" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource MutedBrush}"/>
            </Grid>
            <Border Padding="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10">
              <StackPanel>
                <DockPanel Margin="0,0,0,9">
                  <Button x:Name="AddTaskButton" DockPanel.Dock="Right" Content="Add" Margin="8,0,0,0"/>
                  <TextBox x:Name="TaskInput" Height="36" Padding="10,8" Background="#141518"
                           Foreground="{StaticResource TextBrush}" BorderBrush="#303137" CaretBrush="{StaticResource AccentBrush}"
                           VerticalContentAlignment="Center" ToolTip="Add a task, reminder, or random idea"/>
                </DockPanel>
                <StackPanel x:Name="TaskList"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="3,7,0,0"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <Grid Margin="4,26,4,11">
              <TextBlock Text="Jump into a service" FontSize="15" FontWeight="SemiBold"/>
              <TextBlock Text="No address bar. Only the services you chose."
                         HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
            <UniformGrid Columns="4">
              <Button x:Name="YouTubeHomeButton" Content="YOUTUBE&#x0a;Watch videos" HorizontalContentAlignment="Left"
                      Padding="16" Margin="0,0,7,0"/>
              <Button x:Name="NetflixHomeButton" Content="NETFLIX&#x0a;Watch shows and movies" HorizontalContentAlignment="Left"
                      Padding="16" Margin="4,0"/>
              <Button x:Name="SpotifyHomeButton" Content="SPOTIFY&#x0a;Listen to music and podcasts" HorizontalContentAlignment="Left"
                      Padding="16" Margin="7,0,0,0"/>
              <Button x:Name="AppsHomeButton" Content="APPS &amp; GAMES&#x0a;Open your library" HorizontalContentAlignment="Left"
                      Padding="16" Margin="7,0,0,0"/>
            </UniformGrid>
            <TextBlock Text="Your service sign-ins and browsing data stay on this PC. Homebase does not store your service passwords."
                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="4,16,4,0"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="YouTubeTab" Header="▶   YouTube">
        <Grid Background="#111214">
          <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="13,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <CheckBox x:Name="YouTubeBlockToggle" Content="Block ad/tracker domains" IsChecked="True"
                        Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
              <Button x:Name="YouTubeBackButton" Content="←" Padding="9,4" Margin="0,0,5,0" ToolTip="Back"/>
              <Button x:Name="YouTubeForwardButton" Content="→" Padding="9,4" Margin="0,0,5,0" ToolTip="Forward"/>
              <Button x:Name="YouTubeReloadButton" Content="Reload" Padding="10,4" ToolTip="Reload"/>
            </StackPanel>
            <TextBlock Text="LOCKED TO YOUTUBE + REQUIRED GOOGLE SIGN-IN" Foreground="{StaticResource MutedBrush}"
                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
          <wv2:WebView2 x:Name="YouTubeView" Grid.Row="1" DefaultBackgroundColor="#111214"/>
        </Grid>
      </TabItem>

      <TabItem x:Name="NetflixTab" Header="▣   Netflix">
        <Grid Background="#111214">
          <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="13,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <CheckBox x:Name="NetflixBlockToggle" Content="Block ad/tracker domains" IsChecked="True"
                        Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
              <Button x:Name="NetflixBackButton" Content="←" Padding="9,4" Margin="0,0,5,0" ToolTip="Back"/>
              <Button x:Name="NetflixForwardButton" Content="→" Padding="9,4" Margin="0,0,5,0" ToolTip="Forward"/>
              <Button x:Name="NetflixReloadButton" Content="Reload" Padding="10,4" ToolTip="Reload"/>
            </StackPanel>
            <TextBlock Text="LOCKED TO NETFLIX" Foreground="{StaticResource MutedBrush}"
                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
          <wv2:WebView2 x:Name="NetflixView" Grid.Row="1" DefaultBackgroundColor="#111214"/>
        </Grid>
      </TabItem>

      <TabItem x:Name="SpotifyTab" Header="♫   Spotify">
        <Grid Background="#111214">
          <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="13,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <CheckBox x:Name="SpotifyBlockToggle" Content="Block ad/tracker domains" IsChecked="True"
                        Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
              <Button x:Name="SpotifyBackButton" Content="←" Padding="9,4" Margin="0,0,5,0" ToolTip="Back"/>
              <Button x:Name="SpotifyForwardButton" Content="→" Padding="9,4" Margin="0,0,5,0" ToolTip="Forward"/>
              <Button x:Name="SpotifyReloadButton" Content="Reload" Padding="10,4" ToolTip="Reload"/>
            </StackPanel>
            <TextBlock Text="LOCKED TO SPOTIFY + REQUIRED SIGN-IN" Foreground="{StaticResource MutedBrush}"
                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
          <wv2:WebView2 x:Name="SpotifyView" Grid.Row="1" DefaultBackgroundColor="#111214"/>
        </Grid>
      </TabItem>

      <TabItem x:Name="AppsTab" Header="▦   Apps">
        <Grid Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="2,0,2,16">
            <Button x:Name="ScanAppsButton" DockPanel.Dock="Right" Content="Scan for apps"
                    Style="{StaticResource PrimaryButton}" Padding="15,8"/>
            <StackPanel>
              <TextBlock Text="Your apps and games" FontSize="26" FontWeight="SemiBold"/>
              <TextBlock Text="Find shortcuts from your Start Menu, desktop, and installed Steam libraries."
                         Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
          </DockPanel>
          <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <ComboBox x:Name="AppCategoryFilter" DockPanel.Dock="Right" Width="140" Height="34"
                      SelectedIndex="0" Margin="8,0,0,0">
              <ComboBoxItem Content="Everything"/>
              <ComboBoxItem Content="Apps"/>
              <ComboBoxItem Content="Games"/>
            </ComboBox>
            <TextBox x:Name="AppSearchInput" Height="34" Padding="10,7" Background="#141518"
                     Foreground="{StaticResource TextBrush}" BorderBrush="#303137"
                     CaretBrush="{StaticResource AccentBrush}" VerticalContentAlignment="Center"
                     ToolTip="Search your app and game library"/>
          </DockPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AppList"/>
          </ScrollViewer>
          <TextBlock x:Name="AppStatusText" Grid.Row="3" Foreground="{StaticResource AccentBrush}"
                     FontSize="11" Margin="3,10,3,0" TextWrapping="Wrap"/>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#151619" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="HOMEBASE  ·  MEDIA PAGES ARE RESTRICTED TO THE APPROVED SERVICES"
                 Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold"
                 VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Border>
  </Grid>
</Window>
